<mxfile host="drawio"><diagram id="layerwise" name="Layer-wise staircase"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Proposed: layer-by-layer fine-tuning with the exact staircase&lt;/b&gt;&lt;br&gt;ResNet-20 on CIFAR-10, 2/2 bits. The 18 block convolutions are quantized one after another, from the input to the output." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1560" height="55" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="75" width="1560" height="345" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;A. One stage k (k = 1, …, 18): what every layer does&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontSize=16;" vertex="1" parent="1"><mxGeometry x="35" y="83" width="1530" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;training images" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#FFFFFF;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="45" y="140" width="110" height="120" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;First convolution&lt;/b&gt;&lt;br&gt;float&lt;br&gt;(never quantized)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#FFFFFF;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="195" y="140" width="150" height="120" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Layers 1 … k−1&lt;/b&gt;&lt;br&gt;&lt;i&gt;frozen&lt;/i&gt;&lt;br&gt;forward: exact rounding&lt;br&gt;no update" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#E0E0E0;strokeColor=#616161;" vertex="1" parent="1"><mxGeometry x="385" y="140" width="225" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Layer k&lt;/b&gt;&lt;br&gt;&lt;i&gt;optimized&lt;/i&gt;&lt;br&gt;forward: staircase S&lt;sub&gt;α,β&lt;/sub&gt;&lt;br&gt;backward: exact gradient of S" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="650" y="140" width="240" height="120" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Layers k+1 … 18&lt;/b&gt;&lt;br&gt;&lt;i&gt;trained with the STE&lt;/i&gt;&lt;br&gt;forward: exact rounding&lt;br&gt;backward: slope 1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#BBDEFB;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="930" y="140" width="245" height="120" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Final linear layer&lt;/b&gt;&lt;br&gt;float&lt;br&gt;(never quantized)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#FFFFFF;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="1215" y="140" width="150" height="120" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Loss&lt;/b&gt;&lt;br&gt;cross-entropy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#FFFFFF;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="1405" y="140" width="150" height="120" as="geometry"/></mxCell><mxCell id="c12" value="" style="endArrow=classic;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=#FAFAFA;strokeColor=#212121;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="endArrow=classic;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=#FAFAFA;strokeColor=#212121;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="endArrow=classic;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=#FAFAFA;strokeColor=#212121;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="endArrow=classic;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=#FAFAFA;strokeColor=#212121;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="endArrow=classic;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=#FAFAFA;strokeColor=#212121;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="endArrow=classic;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=#FAFAFA;strokeColor=#212121;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="forward pass →" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="45" y="112" width="200" height="22" as="geometry"/></mxCell><mxCell id="c19" value="gradient (backpropagation): updates layer k and layers k+1 … 18" style="endArrow=classic;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=#FAFAFA;dashed=1;strokeColor=#C62828;fontColor=#C62828;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c11" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480" y="305"/><mxPoint x="770" y="305"/></Array></mxGeometry></mxCell><mxCell id="c20" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#E0E0E0;strokeColor=#616161;" vertex="1" parent="1"><mxGeometry x="45" y="345" width="34" height="24" as="geometry"/></mxCell><mxCell id="c21" value="frozen, exact rounding (R)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="87" y="347" width="320" height="24" as="geometry"/></mxCell><mxCell id="c22" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#FFE0B2;strokeColor=#E65100;" vertex="1" parent="1"><mxGeometry x="425" y="345" width="34" height="24" as="geometry"/></mxCell><mxCell id="c23" value="staircase S, exact backward (S)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="467" y="347" width="320" height="24" as="geometry"/></mxCell><mxCell id="c24" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#BBDEFB;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="805" y="345" width="34" height="24" as="geometry"/></mxCell><mxCell id="c25" value="STE: rounding, slope-1 backward" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="847" y="347" width="320" height="24" as="geometry"/></mxCell><mxCell id="c26" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#FFFFFF;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="1185" y="345" width="34" height="24" as="geometry"/></mxCell><mxCell id="c27" value="float, not quantized" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1227" y="347" width="320" height="24" as="geometry"/></mxCell><mxCell id="c28" value="Every training step sends a batch through all layers; only layer k and the layers after it change." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="45" y="380" width="1200" height="24" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="435" width="760" height="385" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;B. The stages, from the input to the output&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontSize=16;" vertex="1" parent="1"><mxGeometry x="35" y="443" width="730" height="30" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;L1&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="175" y="480" width="90" height="28" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;L2&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="271" y="480" width="90" height="28" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;L3&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="367" y="480" width="90" height="28" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;…&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="463" y="480" width="90" height="28" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;L17&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="559" y="480" width="90" height="28" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;L18&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="655" y="480" width="90" height="28" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Stage 1&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="515" width="125" height="36" as="geometry"/></mxCell><mxCell id="c38" value="S" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="175" y="515" width="90" height="36" as="geometry"/></mxCell><m