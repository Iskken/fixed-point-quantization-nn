ell><mxCell id="c67" value="R" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#E0E0E0;strokeColor=#616161;" vertex="1" parent="1"><mxGeometry x="271" y="691" width="90" height="36" as="geometry"/></mxCell><mxCell id="c68" value="R" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#E0E0E0;strokeColor=#616161;" vertex="1" parent="1"><mxGeometry x="367" y="691" width="90" height="36" as="geometry"/></mxCell><mxCell id="c69" value="…" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="463" y="691" width="90" height="36" as="geometry"/></mxCell><mxCell id="c70" value="R" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#E0E0E0;strokeColor=#616161;" vertex="1" parent="1"><mxGeometry x="559" y="691" width="90" height="36" as="geometry"/></mxCell><mxCell id="c71" value="S" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="655" y="691" width="90" height="36" as="geometry"/></mxCell><mxCell id="c72" value="&lt;b&gt;Deployed&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="735" width="125" height="36" as="geometry"/></mxCell><mxCell id="c73" value="R" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#E0E0E0;strokeColor=#616161;" vertex="1" parent="1"><mxGeometry x="175" y="735" width="90" height="36" as="geometry"/></mxCell><mxCell id="c74" value="R" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#E0E0E0;strokeColor=#616161;" vertex="1" parent="1"><mxGeometry x="271" y="735" width="90" height="36" as="geometry"/></mxCell><mxCell id="c75" value="R" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#E0E0E0;strokeColor=#616161;" vertex="1" parent="1"><mxGeometry x="367" y="735" width="90" height="36" as="geometry"/></mxCell><mxCell id="c76" value="…" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="463" y="735" width="90" height="36" as="geometry"/></mxCell><mxCell id="c77" value="R" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#E0E0E0;strokeColor=#616161;" vertex="1" parent="1"><mxGeometry x="559" y="735" width="90" height="36" as="geometry"/></mxCell><mxCell id="c78" value="R" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#E0E0E0;strokeColor=#616161;" vertex="1" parent="1"><mxGeometry x="655" y="735" width="90" height="36" as="geometry"/></mxCell><mxCell id="c79" value="Each stage ends by early stopping (panel C). After stage 18 every layer uses exact rounding, which is exactly the deployed network." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="40" y="778" width="720" height="40" as="geometry"/></mxCell><mxCell id="c80" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;arcSize=2;" vertex="1" parent="1"><mxGeometry x="800" y="435" width="780" height="640" as="geometry"/></mxCell><mxCell id="c81" value="&lt;b&gt;C. Inside one stage: early stopping with rollback&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontSize=16;" vertex="1" parent="1"><mxGeometry x="815" y="443" width="750" height="30" as="geometry"/></mxCell><mxCell id="c82" value="Start stage k from the best weights of stage k−1&lt;br&gt;(stage 1: the float model)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#FFFFFF;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="880" y="485" width="330" height="55" as="geometry"/></mxCell><mxCell id="c83" value="Train one epoch&lt;br&gt;(layer k: S with exact backward; layers after k: STE)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#FFE0B2;strokeColor=#E65100;" vertex="1" parent="1"><mxGeometry x="880" y="570" width="330" height="55" as="geometry"/></mxCell><mxCell id="c84" value="Validate on the validation set (5k images)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#FFFFFF;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="880" y="655" width="330" height="45" as="geometry"/></mxCell><mxCell id="c85" value="Best so far?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#FFFFFF;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="935" y="730" width="220" height="80" as="geometry"/></mxCell><mxCell id="c86" value="Save a checkpoint&lt;br&gt;(the best weights so far)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#FFFFFF;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="1290" y="742" width="250" height="55" as="geometry"/></mxCell><mxCell id="c87" value="No improvement&lt;br&gt;for P epochs?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#FFFFFF;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="935" y="845" width="220" height="85" as="geometry"/></mxCell><mxCell id="c88" value="&lt;b&gt;Roll back&lt;/b&gt; to the best checkpoint,&lt;br&gt;&lt;b&gt;freeze&lt;/b&gt; layer k at exact rounding" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#E0E0E0;strokeColor=#616161;" vertex="1" parent="1"><mxGeometry x="880" y="960" width="330" height="50" as="geometry"/></mxCell><mxCell id="c89" value="Next stage: k = k + 1&lt;br&gt;(after stage 18: evaluate on the test set)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#FFFFFF;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="880" y="1030" width="330" height="40" as="geometry"/></mxCell><mxCell id="c90" value="" style="endArrow=classic;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=#FAFAFA;" edge="1" parent="1" source="c82" target="c83"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c91" value="" style="endArrow=classic;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=#FAFAFA;" edge="1" parent="1" source="c83" target="c84"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c92" value="" style="endArrow=classic;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=#FAFAFA;" edge="1" parent="1" source="c84" target="c85"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c93" value="yes" style="endArrow=classic;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=#FAFAFA;fontStyle=1;" edge="1" parent="1" source="c85" target="c86"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c94" value="" style="endArrow=classic;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=#FAFAFA;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="c86" target="c83"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1415" y="597"/></Array></mxGeometry></mxCell><mxCell id="c95" value="no" style="endArrow=classic;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=#FAFAFA;fontStyle=1;" edge="1" parent="1" source="c85" target="c87"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c96" value="no" style="endArrow=classic;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=#FAFAFA;fontStyle=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c87" target="c83"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="887"/><mxPoint x="840" y="597"/></Array></mxGeometry></mxCell><mxCell id="c97" value="yes" style="endArrow=classic;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=#FAFAFA;fontStyle=1;" edge="1" parent="1" source="c87" target="c88"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c98" value="" style="endArrow=classic;html=1;fontSize=12;strokeWidth=2;labelBackgroundColor=#FAFAFA;" edge="1" parent="1" source="c88" target="c89"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c99" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="835" width="760" height="125" as="geometry"/></mxCell><mxCell id="c100" value="&lt;b&gt;D. Decided with D. Hadházi (19 Nov)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontSize=16;" vertex="1" parent="1"><mxGeometry x="35" y="843" width="730" height="30" as="geometry"/></mxCell><mxCell id="c101" value="• Frozen layers (before k): exact rounding.&lt;br&gt;• Optimized layer k: staircase with the exact backward.&lt;br&gt;• Layers after k: STE (the first experiment; float is an alternative).&lt;br&gt;• No fixed number of epochs per stage: early stopping with rollback." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="868" width="720" height="90" as="geometry"/></mxCell><mxCell id="c102" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="975" width="760" height="150" as="geometry"/></mxCell><mxCell id="c103" value="&lt;b&gt;E. Open questions&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontSize=16;" vertex="1" parent="1"><mxGeometry x="35" y="983" width="730" height="30" as="geometry"/></mxCell><mxCell id="c104" value="1. α within a stage: ramp from 1 to α&lt;sub&gt;end&lt;/sub&gt;, restarting in every stage, then constant until early stopping?&lt;br&gt;2. Early-stopping metric: validation accuracy with layer k rounded (as deployed)? With or without BatchNorm re-estimation?&lt;br&gt;3. Patience P, a maximum number of epochs per stage, and the learning rate per stage (restart, constant, decay)?&lt;br&gt;4. Frozen layers: are their BatchNorm layers and quantizer bounds (l, u) frozen as well?&lt;br&gt;5. Float first convolution and final linear layer: trained in every stage?&lt;br&gt;6. Fair comparison: the STE trains 120 epochs; should it also get early stopping?" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1008" width="720" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>